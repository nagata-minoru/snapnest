# macOS
.DS_Store

# 依存パッケージ (node_modules は Spotlight 対策でシンボリックリンクのことがあるため末尾スラッシュなし)
node_modules
node_modules.noindex/

# ビルド成果物
dist/

# Yarn (Zero-Installs は使わない)
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/sdks
!**/.yarn/versions
.pnp.*

# ログ・環境変数
*.log
.env
.env.*
